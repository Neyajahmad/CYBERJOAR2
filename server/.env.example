# MongoDB Connection String
# For local development: mongodb://localhost:27017/urban-growth
# For production (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/urban-growth
MONGODB_URI=mongodb://localhost:27017/urban-growth

# Server Port
PORT=5000

# Frontend URL (for CORS) - Add your Netlify URL here
FRONTEND_URL=https://your-app-name.netlify.app
